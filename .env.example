# Server-side only. Never expose these to the browser.
YOUCAM_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
PROOFPICK_MODEL=claude-opus-5-5
PROOFPICK_MAX_PREVIEWS_PER_SESSION=3
PROOFPICK_MAX_RETRIES_PER_SESSION=1
# Whole-deployment cap on YouCam tasks per UTC day. Set after checking the V4 unit cost in your account.
PROOFPICK_MAX_TASKS_PER_DAY=30
PROOFPICK_POLL_INTERVAL_SECONDS=10
